{
  "format": "fukuaRPA.plugin",
  "manifest_version": 1,
  "id": "ocr-local",
  "name": "本地 OCR（离线文字识别）",
  "version": "1.1.0",
  "author": "fukuaRPA 社区插件",
  "plugin_type": "python_action",
  "_note_p2": "P2 阶段：当前为 Python 实现（python_action），非 WASM 沙箱",
  "api_version": 1,
  "min_app_version": "1.0.0",
  "entrypoint": "src/ocr_local/action.py:run",
  "permissions": [
    "screen.capture_region",
    "input.mouse",
    "variables.write_declared"
  ],
  "dependencies": [],
  "templates": [],
  "actions": [
    {
      "id": "ocr_find_click",
      "name": "OCR 识别文字并点击",
      "description": "对指定区域做离线文字识别，找到目标文本后返回其区域局部坐标（由宿主叠加区域原点得到屏幕坐标），由宿主通过 input.mouse 权限执行点击（保证可被急停取消、停止后不残留输入）。",
      "permissions": [
        "screen.capture_region",
        "input.mouse",
        "variables.write_declared"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "target_text": {
            "type": "string",
            "title": "查找文字",
            "description": "要找的文本，命中后点击其位置"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "候选文字列表",
            "description": "多候选时按列表顺序取第一个命中"
          },
          "match_mode": {
            "type": "string",
            "enum": [
              "contains",
              "equals",
              "regex"
            ],
            "default": "contains",
            "title": "匹配方式"
          },
          "score_threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.5,
            "title": "置信度阈值"
          },
          "click_offset": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "default": [
              0.5,
              0.5
            ],
            "title": "点击偏移(包围盒内比例)"
          },
          "set_variable": {
            "type": "string",
            "title": "写入变量",
            "description": "把命中的文字写入声明过的变量"
          },
          "image_path": {
            "type": "string",
            "title": "图片路径(独立模式)"
          },
          "image_b64": {
            "type": "string",
            "title": "Base64图片(P3宿主注入)"
          },
          "region_origin": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "title": "区域屏幕原点[x, y]",
            "description": "P3 宿主注入：区域截图在屏幕上的左上角坐标；提供后 click_x/click_y 叠加为绝对屏幕坐标"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "matched_text": {
            "type": "string"
          },
          "click_x": {
            "type": "number",
            "description": "区域局部 X 坐标（需宿主叠加区域原点）"
          },
          "click_y": {
            "type": "number",
            "description": "区域局部 Y 坐标（需宿主叠加区域原点）"
          },
          "coordinate_space": {
            "type": "string",
            "description": "absolute（已叠加区域原点）或 local（区域局部坐标，宿主须叠加）"
          },
          "score": {
            "type": "number"
          },
          "variable_value": {
            "type": "string"
          },
          "words": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "ocr_read_region",
      "name": "OCR 读取区域文字",
      "description": "对指定区域做离线文字识别，返回全部识别到的文本与坐标，不点击。",
      "permissions": [
        "screen.capture_region"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "score_threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.5,
            "title": "置信度阈值"
          },
          "image_path": {
            "type": "string",
            "title": "图片路径(独立模式)"
          },
          "image_b64": {
            "type": "string",
            "title": "Base64图片(P3宿主注入)"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          },
          "words": {
            "type": "array"
          }
        }
      }
    }
  ],
  "files": [
    {
      "path": "README.md",
      "sha256": "490b9ac21b0a3aba1f6e56ba0e1427a6c0c989f80ba2f2d3851ce40be68e904a"
