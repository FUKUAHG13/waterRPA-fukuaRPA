{
  "format": "fukuaRPA.plugin",
  "manifest_version": 1,
  "id": "office-docs",
  "name": "办公文档（Excel / PDF）",
  "version": "1.1.0",
  "author": "fukuaRPA 社区插件",
  "plugin_type": "python_action",
  "_note_p2": "P2 阶段：当前为 Python 实现（python_action），非 WASM 沙箱",
  "api_version": 1,
  "min_app_version": "1.0.0",
  "entrypoint": "src/office_docs/action.py:run",
  "permissions": [
    "files.user_selected",
    "files.plugin_private_data",
    "variables.write_declared"
  ],
  "dependencies": [],
  "templates": [],
  "actions": [
    {
      "id": "excel_read_cell",
      "name": "Excel 读取单元格",
      "description": "读取指定工作表某单元格的值（.xlsx）。",
      "permissions": [
        "files.user_selected"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "xlsx 路径"
          },
          "sheet": {
            "type": "string",
            "title": "工作表名（空=活动表）"
          },
          "cell": {
            "type": "string",
            "title": "单元格，如 A1"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    {
      "id": "excel_read_range",
      "name": "Excel 读取区域",
      "description": "读取矩形区域，返回二维数组（.xlsx）。",
      "permissions": [
        "files.user_selected"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "xlsx 路径"
          },
          "sheet": {
            "type": "string",
            "title": "工作表名"
          },
          "start": {
            "type": "string",
            "title": "起点，如 A1"
          },
          "end": {
            "type": "string",
            "title": "终点，如 C3"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "excel_write_cell",
      "name": "Excel 写入单元格",
      "description": "写入指定单元格并保存（.xlsx）。",
      "permissions": [
        "files.user_selected"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "xlsx 路径"
          },
          "sheet": {
            "type": "string",
            "title": "工作表名"
          },
          "cell": {
            "type": "string",
            "title": "单元格，如 A1"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ],
            "title": "写入值"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "written": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "id": "excel_write_range",
      "name": "Excel 写入区域",
      "description": "从起点批量写入二维数据并保存（.xlsx）。",
      "permissions": [
        "files.user_selected"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "xlsx 路径"
          },
          "sheet": {
            "type": "string",
            "title": "工作表名"
          },
          "start": {
            "type": "string",
            "title": "起点，如 A1"
          },
          "values": {
            "type": "array",
            "title": "二维数组"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "written": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "id": "excel_find",
      "name": "Excel 查找值",
      "description": "在工作表中查找值，返回所有命中单元格地址（.xlsx）。",
      "permissions": [
        "files.user_selected",
        "variables.write_declared"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "xlsx 路径"
          },
          "sheet": {
            "type": "string",
            "title": "工作表名"
          },
          "value": {
            "type": "string",
            "title": "要查找的值"
          },
          "mode": {
            "type": "string",
            "enum": [
              "contains",
              "equals"
            ],
            "default": "contains"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "addresses": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "excel_sheets",
      "name": "Excel 列出工作表",
      "description": "返回工作簿中所有工作表名称（.xlsx）。",
      "permissions": [
        "files.user_selected"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "xlsx 路径"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "sheets": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "excel_row_count",
      "name": "Excel 行数",
      "description": "返回某工作表的最大行数（.xlsx）。",
      "permissions": [
        "files.user_selected"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "xlsx 路径"
          },
          "sheet": {
            "type": "string",
            "title": "工作表名"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "integer"
          }
        }
      }
    },
    {
      "id": "pdf_page_count",
      "name": "PDF 页数",
      "description": "返回 PDF 文件页数。",
      "permissions": [
        "files.user_selected"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "pdf 路径"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "pages": {
            "type": "integer"
          }
        }
      }
    },
    {
      "id": "pdf_extract_text",
      "name": "PDF 提取文本",
      "description": "提取全部或指定页（如 1-3,5）的文本内容。",
      "permissions": [
        "files.user_selected"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "pdf 路径"
          },
          "pages": {
            "type": "string",
            "title": "页码范围，空=全部"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "pdf_search",
      "name": "PDF 搜索文本",
      "description": "在 PDF 中搜索关键词，返回命中页码与上下文片段。",
      "permissions": [
        "files.user_selected",
        "variables.write_declared"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "pdf 路径"
          },
          "query": {
            "type": "string",
            "title": "查询词或正则"
          },
          "mode": {
            "type": "string",
            "enum": [
              "contains",
              "regex"
            ],
            "default": "contains"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "pdf_merge",
      "name": "PDF 合并",
      "description": "将多个 PDF 合并为一个，返回输出页数。",
      "permissions": [
        "files.user_selected",
        "files.plugin_private_data"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "inputs": {
            "type": "array",
            "title": "输入 pdf 路径列表"
          },
          "output": {
            "type": "string",
            "title": "输出路径"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "pages": {
            "type": "integer"
          }
        }
      }
    },
    {
      "id": "pdf_split",
      "name": "PDF 拆分",
      "description": "按页范围（如 1-2,3）拆分成多个 PDF，返回生成路径列表。",
      "permissions": [
        "files.user_selected",
        "files.plugin_private_data"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "pdf 路径"
          },
          "ranges": {
            "type": "string",
            "title": "页范围，如 1-2,3"
          },
          "output_dir": {
            "type": "string",
            "title": "输出目录"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "outputs": {
            "type": "array"
          }
        }
      }
    }
  ],
  "files": [
